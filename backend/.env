# ========================
# DATABASE CONFIGURATION
# ========================
DATABASE_URL=mssql+pyodbc://sa:manhhung%402005@localhost:1433/elearning_db?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes
# Retries while the SQL Server container is still booting
DB_CONNECT_RETRIES=20
DB_CONNECT_RETRY_DELAY=3

# ========================
# JWT CONFIGURATION
# ========================
JWT_SECRET_KEY=super-secret-key-project3-2026-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Set to true when served over HTTPS
COOKIE_SECURE=false

# ========================
# INITIAL ADMIN ACCOUNT (created on startup if missing)
# ========================
FIRST_ADMIN_EMAIL=admin@elearning.vn
FIRST_ADMIN_PASSWORD=Admin123@
FIRST_ADMIN_FULL_NAME=Quản trị viên

# ========================
# MINIO CONFIGURATION
# ========================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=miniopassword2026
MINIO_SECURE=false
MINIO_REGION=us-east-1
# URL the browser uses to download files (differs from MINIO_ENDPOINT inside Docker)
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_BUCKET_MATERIALS=materials
MINIO_BUCKET_THUMBNAILS=thumbnails
MINIO_BUCKET_AVATARS=avatars
MAX_UPLOAD_SIZE_MB=50
PRESIGNED_URL_EXPIRE_MINUTES=60

# ========================
# LEARNING RULES
# ========================
VIDEO_COMPLETION_THRESHOLD=0.8
QUIZ_SUBMIT_GRACE_SECONDS=60

# ========================
# APP CONFIGURATION
# ========================
APP_NAME=ELearning Platform API
APP_VERSION=1.0.0
DEBUG=true
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
